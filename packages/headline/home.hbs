{{!< default}}

<main class="gh-main gh-outer">
    <div class="gh-inner">
        <section class="gh-topic gh-topic-grid">
            <h2 class="gh-topic-name">
                {{#match pagination.pages ">" 1}}
                    <a href="{{@site.url}}/page/2">Latest</a>
                {{else}}
                    Latest
                {{/match}}
            </h2>

            <div class="gh-topic-content">
                {{#foreach posts limit="7"}}
                    {{> "loop-grid"}}
                {{/foreach}}
            </div>

            <footer class="gh-topic-footer">
                {{#match pagination.pages ">" 1}}
                    <a class="gh-topic-link" href="{{@site.url}}/page/2">Show more {{> "icons/arrow"}}</a>
                {{/match}}
            </footer>
        </section>

        {{!-- the way ghost orders these tags in the db doesn't allow custom ordering, so we have to hardcode them --}}
        {{#get "tags" filter="slug:video-editing" limit="1"}}
            {{#foreach tags}}
                {{> "topic-grid"}}
            {{/foreach}}
        {{/get}}
        {{#get "tags" filter="slug:content-creator" limit="1"}}
            {{#foreach tags}}
                {{> "topic-grid"}}
            {{/foreach}}
        {{/get}}
        {{#get "tags" filter="slug:social-media" limit="1"}}
            {{#foreach tags}}
                {{> "topic-grid"}}
            {{/foreach}}
        {{/get}}
        {{#get "tags" filter="slug:ai" limit="1"}}
            {{#foreach tags}}
                {{> "topic-grid"}}
            {{/foreach}}
        {{/get}}
        {{#get "tags" filter="slug:design" limit="1"}}
            {{#foreach tags}}
                {{> "topic-grid"}}
            {{/foreach}}
        {{/get}}
        {{#get "tags" filter="slug:caption" limit="1"}}
            {{#foreach tags}}
                {{> "topic-grid"}}
            {{/foreach}}
        {{/get}}

        <div class="gh-topic-list">
            {{#get "tags" filter="slug:youtube"}}
                {{#foreach tags}}
                    {{> "topic-minimal"}}
                {{/foreach}}
            {{/get}}
            {{#get "tags" filter="slug:tiktok"}}
                {{#foreach tags}}
                    {{> "topic-minimal"}}
                {{/foreach}}
            {{/get}}
            {{#get "tags" filter="slug:instagram"}}
                {{#foreach tags}}
                    {{> "topic-minimal"}}
                {{/foreach}}
            {{/get}}
        </div>
    </div>
</main>